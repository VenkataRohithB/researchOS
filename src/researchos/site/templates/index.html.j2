<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="referrer" content="no-referrer">
<meta name="generator" content="ResearchOS">
<title>{{ title }}</title>
<style>{{ css }}</style>
</head>
<body data-depth="beginner">
<a class="skip-link" href="#view">Skip to content</a>
<header class="bar">
  <a class="bar-title" href="#/">{{ title }}</a>
  <nav class="bar-nav" aria-label="Views">
    <a href="#/learn" data-view="learn">Learn</a>
    <a href="#/map" data-view="map">Map</a>
    <a href="#/read" data-view="read">Read</a>
    <a href="#/revise" data-view="revise">Revise</a>
    <a href="#/sources" data-view="sources">Sources</a>
  </nav>
  <div class="bar-tools">
    <button type="button" class="search-open" id="search-open" aria-haspopup="dialog">Search <kbd>/</kbd></button>
    <button type="button" class="theme" id="theme" aria-label="Change theme">Theme</button>
  </div>
</header>

<main id="view" tabindex="-1">
  <noscript>
    <section class="noscript">
      <h1>{{ title }}</h1>
      <p>This site needs JavaScript for navigation. The concepts it covers:</p>
      <ul>
      {% for concept in data.concepts.values() %}
        <li><strong>{{ concept.title }}</strong></li>
      {% endfor %}
      </ul>
    </section>
  </noscript>
</main>

<div class="search" id="search" role="dialog" aria-modal="true" aria-label="Search" hidden>
  <div class="search-box">
    <label class="visually-hidden" for="search-input">Search concepts, claims and sources</label>
    <input id="search-input" type="search" placeholder="Search concepts, claims and sources" autocomplete="off" spellcheck="false">
    <div class="search-results" id="search-results"></div>
  </div>
</div>

<aside class="evidence" id="evidence" aria-live="polite" hidden></aside>

<script type="application/json" id="data">{{ data_json }}</script>
<script>{{ js }}</script>
</body>
</html>
