# Copy to .env and fill in real values. Never commit .env.
# With the "mock" providers everything runs offline, with no credentials.

# LLM: "mock" or "openai_compatible" (any OpenAI Chat Completions-compatible endpoint)
LLM_PROVIDER=mock
LLM_MODEL=your-model-name
LLM_API_KEY=sk-dummy-replace-me
LLM_BASE_URL=https://api.example.com/v1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# USD per 1M tokens, used for local cost tracking
LLM_PRICE_IN=0
LLM_PRICE_OUT=0

# Web search: "mock" or "tavily"
SEARCH_PROVIDER=mock
SEARCH_API_KEY=tvly-dummy-replace-me

# Budget limits per run
MAX_STEPS=150
MAX_COST_USD=5
MAX_WALL_SECONDS=3600

# Where research projects are written
WORKSPACE_DIR=workspace
